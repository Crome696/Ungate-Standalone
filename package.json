{
	"name": "ungate-standalone",
	"version": "1.1.0",
	"private": true,
	"description": "Standalone desktop host for the Ungate local proxy, dashboard, and Cloudflare tunnel",
	"author": "ungate-standalone",
	"license": "MIT",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"prepare:resources": "node scripts/prepare-resources.mjs",
		"build:host": "tsc && node scripts/copy-preload.mjs",
		"dev": "pnpm run build:host && electron .",
		"build": "pnpm run prepare:resources && pnpm run build:host && node scripts/package-current.mjs",
		"build:win": "pnpm run prepare:resources && pnpm run build:host && electron-builder --win portable nsis --x64 --publish never",
		"build:mac": "pnpm run prepare:resources && pnpm run build:host && electron-builder --mac dmg zip --x64 --arm64 --publish never",
		"build:linux": "pnpm run prepare:resources && pnpm run build:host && electron-builder --linux AppImage deb --x64 --arm64 --publish never",
		"build:linux:x64": "pnpm run prepare:resources && pnpm run build:host && electron-builder --linux AppImage deb --x64 --publish never",
		"build:linux:arm64": "pnpm run prepare:resources && pnpm run build:host && electron-builder --linux AppImage deb --arm64 --publish never",
		"start": "electron .",
		"lint": "eslint src scripts",
		"lint:fix": "eslint src scripts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"cloudflared": "~0.7.1",
		"tar": "~6.2.1"
	},
	"devDependencies": {
		"@types/node": "~22.15.35",
		"@typescript-eslint/parser": "~8.57.2",
		"electron": "~35.2.1",
		"electron-builder": "~26.0.12",
		"eslint": "~9.39.5",
		"eslint-config-prettier": "~10.1.8",
		"eslint-import-resolver-typescript": "~4.4.5",
		"eslint-plugin-import-x": "~4.16.2",
		"eslint-plugin-prettier": "~5.5.6",
		"globals": "~17.4.0",
		"prettier": "~3.8.5",
		"typescript": "~5.7.3",
		"typescript-eslint": "~8.57.2"
	},
	"build": {
		"appId": "com.ungate.standalone",
		"productName": "UngateStandalone",
		"copyright": "Ungate is MIT-licensed by orchidfiles.com",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "resources/runtime",
				"to": "runtime"
			},
			{
				"from": "resources/api",
				"to": "api"
			},
			{
				"from": "resources/web",
				"to": "web"
			},
			{
				"from": "resources/icon.png",
				"to": "icon.png"
			}
		],
		"asarUnpack": [
			"node_modules/cloudflared/**"
		],
		"beforePack": "./scripts/before-pack.cjs",
		"win": {
			"icon": "resources/icon.png",
			"signAndEditExecutable": false,
			"target": [
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				},
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"mac": {
			"icon": "resources/icon.png",
			"category": "public.app-category.developer-tools",
			"identity": null,
			"artifactName": "UngateStandalone-${version}-${os}-${arch}.${ext}",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"linux": {
			"icon": "resources/icon.png",
			"category": "Development",
			"artifactName": "UngateStandalone-${version}-${os}-${arch}.${ext}",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "deb",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"portable": {
			"artifactName": "UngateStandalone.exe"
		},
		"nsis": {
			"artifactName": "UngateStandalone-Setup.exe",
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"dmg": {
			"artifactName": "UngateStandalone-${version}-${os}-${arch}.${ext}"
		},
		"publish": null
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"cloudflared",
			"electron-winstaller"
		]
	}
}
