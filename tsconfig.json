{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"declaration": false,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["src/preload.ts"]
}
